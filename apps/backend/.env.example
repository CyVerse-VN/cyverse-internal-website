# Application
APP_ENV=development
APP_NAME=CyVerse Internal Tools API
API_V1_PREFIX=/api/v1

# CORS. Comma-separated list of allowed web origins, or regex pattern.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Authentication. Generate a unique random secret with at least 32 characters.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=cyverse-backend
AUTH_JWT_AUDIENCE=cyverse-internal-web
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30

# PostgreSQL. Replace every connection detail for deployed environments.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cyverse

# Set this for a Supabase direct DATABASE_URL when the runtime network is IPv4-only.
SUPABASE_POOLER_REGION=ap-southeast-2

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional AI Research source credentials. Runtime behavior is configured in
# apps/backend/src/app/tools/research/config.py.
RESEARCH_SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_OPENALEX_API_KEY=