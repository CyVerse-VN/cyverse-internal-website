# Application
APP_ENV=development
APP_NAME=CyVerse Internal Tools API
API_V1_PREFIX=/api/v1

# CORS. Comma-separated list of allowed web origins, or regex pattern.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Authentication. Generate a unique random secret with at least 32 characters.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=cyverse-backend
AUTH_JWT_AUDIENCE=cyverse-internal-web
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30

# TiDB Cloud PostgreSQL. Replace placeholders with the console connection details.
# Percent-encode special characters in the password. Keep credentials server-side.
DATABASE_URL=postgresql://INSTANCE.postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@INSTANCE.gateway01.us-east-1.prod.aws.pg.tidbcloud.com:5432/cyverse_internal?sslmode=verify-full

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional AI Research source credentials. Runtime behavior is configured in
# apps/backend/src/app/tools/research/config.py.
RESEARCH_SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_OPENALEX_API_KEY=

# Threads tool. Shares GROQ_API_KEY above; no separate scraper environment file.
THREADS_ENABLED=false
THREADS_EMBEDDED_WORKER=true
THREADS_TXT_ARCHIVE_ENABLED=false
THREADS_ANONYMOUS=false
# JSON array, wrapped in single quotes for dotenv. Use opaque IDs for session filenames.
# Each account supports id, username, password, totp_secret, proxy, and enabled.
# Omit proxy for a direct connection. Omit credentials when reusing saved sessions.
THREADS_ACCOUNTS='[]'
# THREADS_ACCOUNTS='[{"id":"acc_01","username":"replace-me","password":"replace-me","enabled":true}]'
THREADS_SESSIONS_DIR=.local/threads/sessions
THREADS_GROQ_MODEL=qwen/qwen3.8-27b
THREADS_KEYWORDS_PER_QUERY=3
THREADS_MIN_DELAY_SECONDS=2
THREADS_MAX_DELAY_SECONDS=4
THREADS_RUN_TIMEOUT_SECONDS=1800
# Per-keyword search budget. This is separate from the full collection timeout.
THREADS_SEARCH_TIMEOUT_SECONDS=120
THREADS_WORKER_POLL_SECONDS=2
THREADS_WORKER_RESTART_SECONDS=5
THREADS_WORKER_ADVISORY_LOCK_ID=73193604

# Cloudinary: authenticated raw TXT archives, one asset per Threads session.
# Keep all credentials on the backend. Fill these in before enabling cloud archives.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
